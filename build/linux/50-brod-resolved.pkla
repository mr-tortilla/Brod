; То же правило, что 50-brod-resolved.rules, в формате старого polkit 0.105 (Ubuntu 22.04):
; режим TUN Brod настраивает DNS своего интерфейса в systemd-resolved без запроса пароля.
; Только эти четыре действия, только администраторам в активном локальном сеансе.
[Brod: DNS интерфейса TUN в systemd-resolved]
Identity=unix-group:sudo;unix-group:wheel;unix-group:admin
Action=org.freedesktop.resolve1.set-dns-servers;org.freedesktop.resolve1.set-domains;org.freedesktop.resolve1.set-default-route;org.freedesktop.resolve1.revert
ResultAny=no
ResultInactive=no
ResultActive=yes
